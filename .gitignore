# ==========================================
# Databricks
# ==========================================
.databricks/

# ==========================================
# Entornos virtuales y dependencias de Python
# ==========================================
.venv/
env/
venv/
ENV/
build/
dist/
*.egg-info/
*.egg

# Bytecode y caché de Python
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# Cachés de testing, linters y uv
# ==========================================
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ==========================================
# Secretos y variables de entorno (Crucial en Databricks)
# ==========================================
.env
.env.*
*.secret

# ==========================================
# Backups y archivos temporales
# ==========================================
*.bak
*.tmp
*.swp
*~

# ==========================================
# IDEs y Sistema Operativo (macOS)
# ==========================================
.DS_Store
.vscode/
.idea/

# ==========================================
# Carpetas de trabajo temporal y exploración
# ==========================================
scratch/**
!scratch/README.md

**/explorations/**
!**/explorations/README.md